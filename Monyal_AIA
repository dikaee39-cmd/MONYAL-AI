        Lighting.Brightness = 2.4; Lighting.ClockTime = 17.8
    elseif presetName == "Cyberpunk Night" then
        bloom.Enabled = true; bloom.Intensity = 1.1; bloom.Size = 28; bloom.Threshold = 0.75
        cc.Enabled = true; cc.Brightness = -0.02; cc.Contrast = 0.3; cc.Saturation = 0.45; cc.TintColor = Color3.fromRGB(205, 185, 255)
        sunRays.Enabled = false; dof.Enabled = false
        Lighting.Brightness = 1.4; Lighting.ClockTime = 22.5
    elseif presetName == "Anime Vibrant" then
        bloom.Enabled = true; bloom.Intensity = 0.45; bloom.Size = 20; bloom.Threshold = 1.0
        cc.Enabled = true; cc.Brightness = 0.06; cc.Contrast = 0.15; cc.Saturation = 0.5; cc.TintColor = Color3.fromRGB(245, 252, 255)
        sunRays.Enabled = true; sunRays.Intensity = 0.12; dof.Enabled = false
        Lighting.Brightness = 2.6; Lighting.ClockTime = 13.5
    elseif presetName == "Horror Fog" then
        bloom.Enabled = false; sunRays.Enabled = false; dof.Enabled = true; dof.FarIntensity = 0.35; dof.FocusDistance = 20
