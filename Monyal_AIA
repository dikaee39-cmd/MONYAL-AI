local function cleanAIText(rawText)
    if not rawText then return "" end
    local text = rawText:gsub("<think>.-</think>", "")
    text = text:gsub("%*%*", "")
    text = text:gsub("%*", "")
    text = text:gsub("###%s*", "")
    text = text:gsub("##%s*", "")
    text = text:gsub("#%s*", "")
    text = text:gsub("`", "")
    text = text:gsub("\n>%s*", "\n")
    text = text:gsub("^>%s*", "")
    text = text:gsub("[\128-\255]", "")
    text = text:gsub("  +", " ")
    return text:match("^%s*(.-)%s*$") or ""
end

local function sendRobloxChat(msg)
    msg = cleanAIText(msg):gsub("[\r\n]+", " ")
    if not msg or msg == "" then return end

    local chunks = {}
    for i = 1, #msg, 190 do
        table.insert(chunks, msg:sub(i, i + 189))
    end

    for _, chunk in ipairs(chunks) do
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local textChannels = TextChatService:FindFirstChild("TextChannels")
            local generalChannel = textChannels and textChannels:FindFirstChild("RBXGeneral")
            if generalChannel then
                generalChannel:SendAsync(chunk)
            end
        else
            local defaultChat = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
            local sayMessage = defaultChat and defaultChat:FindFirstChild("SayMessageRequest")
            if sayMessage then
                sayMessage:FireServer(chunk, "All")
            end
        end
        task.wait(0.75)
    end
end

