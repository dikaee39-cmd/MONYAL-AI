local function getOrCreateEffect(className, name)
    local existing = Lighting:FindFirstChild(name)
    if existing and existing:IsA(className) then return existing end
    local inst = Instance.new(className)
    inst.Name = name
    inst.Parent = Lighting
    return inst
end

local function applyMapShader(presetName)
    local bloom = getOrCreateEffect("BloomEffect", "Monyal_Bloom")
    local cc = getOrCreateEffect("ColorCorrectionEffect", "Monyal_CC")
    local sunRays = getOrCreateEffect("SunRaysEffect", "Monyal_SunRays")
    local dof = getOrCreateEffect("DepthOfFieldEffect", "Monyal_DOF")

    if presetName == "Default" then
        bloom.Enabled = false
        cc.Enabled = false
        sunRays.Enabled = false
        dof.Enabled = false
        Lighting.Brightness = 2
        Lighting.Ambient = Color3.fromRGB(127, 127, 127)
        Lighting.OutdoorAmbient = Color3.fromRGB(127, 127, 127)
        Lighting.FogEnd = 100000
    elseif presetName == "RTX Glossy" then
        bloom.Enabled = true; bloom.Intensity = 0.65; bloom.Size = 24; bloom.Threshold = 0.95
        cc.Enabled = true; cc.Brightness = 0.04; cc.Contrast = 0.22; cc.Saturation = 0.25; cc.TintColor = Color3.fromRGB(255, 250, 244)
        sunRays.Enabled = true; sunRays.Intensity = 0.18; sunRays.Spread = 0.7
        dof.Enabled = true; dof.FarIntensity = 0.12; dof.FocusDistance = 45; dof.InFocusRadius = 35
        Lighting.Brightness = 2.8; Lighting.ClockTime = 16.5
    elseif presetName == "Golden Sunset" then
        bloom.Enabled = true; bloom.Intensity = 0.8; bloom.Size = 30; bloom.Threshold = 0.85
        cc.Enabled = true; cc.Brightness = 0.03; cc.Contrast = 0.18; cc.Saturation = 0.35; cc.TintColor = Color3.fromRGB(255, 210, 165)
