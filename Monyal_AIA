local flyBodyGyro, flyBodyVel
local function setFlyMode(enable)
    AVATAR_STATE.Flying = enable
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    if enable and root and hum then
        hum.PlatformStand = true
        flyBodyGyro = Instance.new("BodyGyro")
        flyBodyGyro.P = 9e4
        flyBodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        flyBodyGyro.CFrame = root.CFrame
        flyBodyGyro.Parent = root

        flyBodyVel = Instance.new("BodyVelocity")
        flyBodyVel.Velocity = Vector3.new(0, 0, 0)
        flyBodyVel.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        flyBodyVel.Parent = root
        notifyIsland("Fly Mode: ON", THEME.Green)
    else
        if flyBodyGyro then flyBodyGyro:Destroy() flyBodyGyro = nil end
        if flyBodyVel then flyBodyVel:Destroy() flyBodyVel = nil end
        if hum then hum.PlatformStand = false end
        notifyIsland("Fly Mode: OFF", THEME.SubText)
    end
end

local function setCharacterTransparency(alpha)
    local char = LocalPlayer.Character
    if not char then return end
    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name ~= "HumanoidRootPart" then
            obj.Transparency = alpha
        elseif obj:IsA("Decal") then
            obj.Transparency = alpha
        end
    end
end

UserInputService.JumpRequest:Connect(function()
    if AVATAR_STATE.InfJump and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end)

RunService.Heartbeat:Connect(function()
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    if not myRoot or not myHum then return end

    if AVATAR_STATE.GhostMode then
        for _, part in ipairs(myChar:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end

    if AVATAR_STATE.AntiSlide and myHum.MoveDirection.Magnitude == 0 and not AVATAR_STATE.Flying then
        myRoot.AssemblyLinearVelocity = Vector3.new(0, myRoot.AssemblyLinearVelocity.Y, 0)
    end

    if AVATAR_STATE.Flying and flyBodyGyro and flyBodyVel and workspace.CurrentCamera then
        local cam = workspace.CurrentCamera
        flyBodyGyro.CFrame = cam.CFrame
        local moveDir = myHum.MoveDirection
        if moveDir.Magnitude > 0 then
            local camForward = cam.CFrame.LookVector
            local camRight = cam.CFrame.RightVector
            local flatForward = Vector3.new(camForward.X, 0, camForward.Z)
            local flatRight = Vector3.new(camRight.X, 0, camRight.Z)
            if flatForward.Magnitude > 0 then flatForward = flatForward.Unit end
            if flatRight.Magnitude > 0 then flatRight = flatRight.Unit end

            local forwardAmount = moveDir:Dot(flatForward)
            local rightAmount = moveDir:Dot(flatRight)
            local flyDir = (camForward * forwardAmount) + (camRight * rightAmount)

            if flyDir.Magnitude > 0 then
                flyBodyVel.Velocity = flyDir.Unit * CONFIG.FLY_SPEED
            else
                flyBodyVel.Velocity = Vector3.new(0, 0, 0)
            end
        else
            flyBodyVel.Velocity = Vector3.new(0, 0, 0)
        end
    end

    local target = AVATAR_STATE.SelectedTarget
    if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
        local targetRoot = target.Character.HumanoidRootPart
        if AVATAR_STATE.HoldHands then
            myRoot.CFrame = targetRoot.CFrame * CFrame.new(2.1, 0, 0)
            myRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            local leftShoulder = (myChar:FindFirstChild("LeftUpperArm") and myChar.LeftUpperArm:FindFirstChild("LeftShoulder"))
                or (myChar:FindFirstChild("Torso") and myChar.Torso:FindFirstChild("Left Shoulder"))
            if leftShoulder then
                leftShoulder.C0 = leftShoulder.C0:Lerp(CFrame.new(-1, 0.5, 0) * CFrame.Angles(math.rad(35), 0, math.rad(-25)), 0.3)
            end
        elseif AVATAR_STATE.Headsit then
            myHum.Sit = true
            myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 2.3, 0.2)
            myRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
    end
end)

