-- ==========================================
-- LISTENER CHAT PUBLIK ROBLOX
-- ==========================================
local isPublicBusy = false
local lastReplyTime = 0

local function handlePublicMessage(player, message)
    if not CONFIG.ENABLED or not player or isPublicBusy then return end
    if player == LocalPlayer and not CONFIG.ALLOW_SELF then return end
    if tick() - lastReplyTime < CONFIG.COOLDOWN then return end

    local question = nil
    if CONFIG.NO_PREFIX_MODE then
        question = message:match("^%s*(.-)%s*$")
    else
        local pLen = #CONFIG.PREFIX
        if message:sub(1, pLen):lower() == CONFIG.PREFIX:lower() then
            question = message:sub(pLen + 1):match("^%s*(.-)%s*$")
        end
    end

    if not question or question == "" then return end

    isPublicBusy = true
    currentTargetPlayer = (player ~= LocalPlayer) and player or currentTargetPlayer
    setStatus("Membalas " .. player.DisplayName, THEME.Accent)

    table.insert(publicHistory, {
        role = "user",
        content = player.DisplayName .. ": " .. question
    })
    while #publicHistory > (CONFIG.MAX_HISTORY + 1) do
        table.remove(publicHistory, 2)
    end

    task.spawn(function()
        local ok, reply = callOpenRouter(publicHistory, 600)
        if ok then
            table.insert(publicHistory, { role = "assistant", content = reply })
            sendRobloxChat(reply)
            lastReplyTime = tick()
            setStatus("Siap", THEME.Green)

            if CONFIG.AUTO_JUMP and LocalPlayer.Character then
                local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                if hum then hum.Jump = true end
            end
            if CONFIG.AUTO_EMOTE then
                task.wait(0.5)
                sendRobloxChat("/e dance")
            end
        else
            setStatus("Error API", THEME.Red)
        end
        isPublicBusy = false
    end)
end

if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
    TextChatService.MessageReceived:Connect(function(textChatMessage)
        if textChatMessage.TextSource then
            local sender = Players:GetPlayerByUserId(textChatMessage.TextSource.UserId)
            handlePublicMessage(sender, textChatMessage.Text)
        end
    end)
else
    for _, player in ipairs(Players:GetPlayers()) do
        player.Chatted:Connect(function(msg) handlePublicMessage(player, msg) end)
    end
    Players.PlayerAdded:Connect(function(player)
        player.Chatted:Connect(function(msg) handlePublicMessage(player, msg) end)
    end)
end

