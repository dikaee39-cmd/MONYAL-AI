    {cmd = "!resetshader", desc = "Kembalikan pencahayaan map ke default"},
    {cmd = "!fpsboost", desc = "Optimalkan partikel & bayangan untuk FPS tinggi"},
    {cmd = "!rejoin", desc = "Masuk ulang ke server ini"}
}

local function executeMonyalCommand(rawCmd)
    local clean = rawCmd:lower():match("^%s*(.-)%s*$")
    if clean == "" then return end

    if clean == "!fly" then
        setFlyMode(true)
    elseif clean == "!unfly" then
        setFlyMode(false)
    elseif clean == "!ghost" then
        AVATAR_STATE.GhostMode = true
        setCharacterTransparency(0.65)
        notifyIsland("Ghost Mode: ON", THEME.Green)
    elseif clean == "!unghost" then
        AVATAR_STATE.GhostMode = false
        setCharacterTransparency(0)
        notifyIsland("Ghost Mode: OFF", THEME.SubText)
    elseif clean == "!invisible" then
        AVATAR_STATE.Invisible = true
        setCharacterTransparency(1)
        notifyIsland("Invisible: ON", THEME.Green)
    elseif clean == "!visible" then
        AVATAR_STATE.Invisible = false
        setCharacterTransparency(0)
        notifyIsland("Invisible: OFF", THEME.SubText)
    elseif clean == "!infjump" then
        AVATAR_STATE.InfJump = not AVATAR_STATE.InfJump
        notifyIsland("InfJump: " .. (AVATAR_STATE.InfJump and "ON" or "OFF"), THEME.Accent)
    elseif clean == "!fpsboost" then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") then obj.Material = Enum.Material.SmoothPlastic end
        end
        Lighting.GlobalShadows = false
        notifyIsland("FPS Boost Aktif", THEME.Green)
    elseif clean == "!rejoin" then
        TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
    else
        notifyIsland("Executed: " .. clean, THEME.Accent)
    end
end

cmdInputBox.FocusLost:Connect(function(enter)
    if enter and cmdInputBox.Text ~= "" then
        executeMonyalCommand(cmdInputBox.Text)
        cmdInputBox.Text = ""
    end
end)

