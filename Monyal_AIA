-- OpenRouter API Caller
local publicHistory = { { role = "system", content = CONFIG.PUBLIC_PROMPT } }
local privateHistory = { { role = "system", content = CONFIG.PRIVATE_PROMPT } }

local function callOpenRouter(historyTable, maxTokens)
    local payload = HttpService:JSONEncode({
        model = CONFIG.MODEL,
        messages = historyTable,
        temperature = CONFIG.TEMPERATURE,
        max_tokens = maxTokens or 900
    })

    local success, response = pcall(function()
        return httpRequest({
            Url = "https://openrouter.ai/api/v1/chat/completions",
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
                ["Authorization"] = "Bearer " .. CONFIG.API_KEY,
                ["HTTP-Referer"] = "https://www.roblox.com",
                ["X-Title"] = "MONYAL Liquid Glass"
            },
            Body = payload
        })
    end)

    if success and response and response.StatusCode == 200 then
        local decoded = HttpService:JSONDecode(response.Body)
        local reply = decoded.choices and decoded.choices[1] and decoded.choices[1].message and decoded.choices[1].message.content
        if reply and reply ~= "" then
            return true, cleanAIText(reply)
        end
        return false, "Respon kosong"
    else
        local status = response and response.StatusCode or "Err"
        return false, "API Error (" .. tostring(status) .. ")"
    end
end

local isPrivateBusy = false
local function askMonyalPrivate(customText)
    if isPrivateBusy then return end
    local question = customText or ChatBox.Text:match("^%s*(.-)%s*$")
    if not question or question == "" then return end

    if not customText then ChatBox.Text = "" end
    isPrivateBusy = true
    addChatBubble("user", question)
    local typingLabel = addChatBubble("bot", "Monyal sedang meracik jawaban...")
    notifyIsland("MONYAL AI berpikir...", THEME.Accent)

    table.insert(privateHistory, { role = "user", content = question })
    while #privateHistory > (CONFIG.MAX_HISTORY + 1) do
        table.remove(privateHistory, 2)
    end

    task.spawn(function()
        local ok, result = callOpenRouter(privateHistory, 1000)
        if ok then
            table.insert(privateHistory, { role = "assistant", content = result })
            typingLabel.Text = result
            notifyIsland("Balasan diterima", THEME.Green)
        else
            typingLabel.Text = "Gagal: " .. tostring(result)
            typingLabel.TextColor3 = THEME.Red
            notifyIsland("Error API", THEME.Red)
        end

        task.defer(function()
            ChatScroll.CanvasPosition = Vector2.new(0, ChatScroll.AbsoluteCanvasSize.Y + 300)
        end)
        isPrivateBusy = false
    end)
end

